# Local MinIO (S3-compatible API)
# Copy to .env and fill in your local bucket credentials.
B2_KEY_ID=your_minio_access_key
B2_APPLICATION_KEY=your_minio_secret_key

# Optional overrides
B2_ENDPOINT_URL=http://127.0.0.1:9000
B2_BUCKET_NAME=egov-hackathon

# Optional aliases (supported by scripts):
# MINIO_ENDPOINT_URL=http://127.0.0.1:9000
# MINIO_BUCKET_NAME=egov-hackathon
